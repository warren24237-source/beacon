{
  "expo": {
    "name": "Beacon",
    "slug": "beacon",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beacon",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.warrenporter.beacon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.warrenporter.beacon",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCECFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B4A"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Beacon checks your contacts to find friends who are on Beacon. Numbers are never stored."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Beacon checks your calendar to tick the dates you are free. Your calendar is never shared."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "799f9108-1c3f-40e3-a13d-4e64365b5259"
      }
    },
    "owner": "wazap242",
    "updates": {
      "url": "https://u.expo.dev/799f9108-1c3f-40e3-a13d-4e64365b5259"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
